{
  "name": "@app/db",
  "version": "0.0.1",
  "private": true,
  "description": "PostgreSQL database access via Drizzle ORM",
  "type": "module",
  "main": "./src/direct.ts",
  "types": "./src/direct.ts",
  "exports": {
    ".": "./src/direct.ts",
    "./direct": "./src/direct.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "varlock run -- drizzle-kit generate",
    "db:migrate": "varlock run -- tsx scripts/migrate.ts",
    "script": "varlock run -- tsx",
    "seed:account-types": "varlock run -- tsx scripts/seed-account-types.ts",
    "seed:bank-accounts": "varlock run -- tsx scripts/seed-bank-accounts.ts",
    "seed:accounts": "varlock run -- tsx scripts/import-accounts.ts"
  },
  "dependencies": {
    "drizzle-orm": "^1.0.0-rc.4",
    "pg": "^8.23.0",
    "varlock": "^1.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "varlock": {
    "loadPath": "../../"
  }
}
