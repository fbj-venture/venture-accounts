{
  "name": "@app/db",
  "version": "0.0.1",
  "private": true,
  "description": "Neon Postgres database access via Drizzle ORM",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./direct": "./src/direct.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "script": "tsx",
    "seed:account-types": "tsx scripts/seed-account-types.ts",
    "seed:bank-accounts": "tsx scripts/seed-bank-accounts.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
