{
  "name": "@app/db",
  "version": "0.0.1",
  "private": true,
  "description": "PostgreSQL database access via Drizzle ORM",
  "type": "module",
  "main": "./src/direct.ts",
  "types": "./src/direct.ts",
  "exports": {
    ".": "./src/direct.ts",
    "./direct": "./src/direct.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "varlock run -- drizzle-kit generate",
    "db:migrate": "varlock run -- tsx scripts/migrate.ts",
    "script": "varlock run -- tsx"
  },
  "dependencies": {
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "pg": "^8.23.1",
    "varlock": "^1.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "varlock": {
    "loadPath": "../../"
  }
}
