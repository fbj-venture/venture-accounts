# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# 
# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ----------

# Development
# PostgreSQL connection string for the pg.Pool driver. On Neon, use the *unpooled* one.
# @required @sensitive @type=url(allowedProtocols=[postgresql])
DATABASE_URL_UNPOOLED=
NEON_BRANCH=dev

# @type=url
BETTER_AUTH_URL=http://localhost:3000
# Optional: other origins the app is served from, comma-separated
# (e.g. https://your-service.up.railway.app). BETTER_AUTH_URL is always trusted.
# @optional=true
BETTER_AUTH_TRUSTED_ORIGINS=
# @required @sensitive
BETTER_AUTH_SECRET=

# @example=Company
APP_COMPANY=<Company Name>

# Optional password for protected PDFs
# @optional @sensitive
PDF_PASSWORD=

# @required @sensitive @type=string(startsWith=re_)
RESEND_API_KEY=
# The From header for outgoing mail, e.g. "Venture Accounts <accounts@mail.example.org>".
# The domain must be verified in Resend (or use onboarding@resend.dev to test).
# @required
EMAIL_FROM=

# File uploads - a Railway Bucket (S3-compatible). Optional: leave blank to
# run without storage (imported PDFs are then simply not kept).
# On Railway: S3_ENDPOINT=${{Bucket.ENDPOINT}} etc. (the bucket service's variables)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
# @sensitive
S3_ACCESS_KEY_ID=
# @sensitive
S3_SECRET_ACCESS_KEY=
